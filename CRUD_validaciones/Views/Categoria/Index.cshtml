@model IEnumerable<CRUD_validaciones.Models.Categoria>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container pt-3">
    <div class="row pt-4">
        
        <div class="col-6">
            <h2 class="text-primary">Lista Categorias</h2>
        </div>
        <div class="col-3">
           
        </div>
        <div class="col-3">
        </div>

    </div>

    <br /> 

    @if (Model.Count() > 0)
    {
        <table class="table table-bordered table-striped" style="width:100%">
            <thead>
               <tr>
                   <th>Nombre Categoria</th>
                    <th>Orden</th>
                    <th>Descripcion</th>
                    <th></th>
               </tr>
            </thead>


            <tbody>
                @foreach(var item in Model)
                {
                    <tr>
                        <th width="40%">@item.NombreCategoria</th>
                        <th width="30%"> @item.Orden</th>
                        <th width="20%">@item.Descripcion</th>
                        <th ></th>
                    </tr>
                }
            </tbody>

        </table>
    }
    else
    {
        <p>No hay registros de Categoria</p>
    }


</div>

